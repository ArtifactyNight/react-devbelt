{
  "name": "react-devbelt",
  "version": "0.1.0",
  "description": "A pluggable in-browser dev toolbar for React and Next.js: network and console logs, responsive viewport frames, element grab, and agent-readable debug bundles.",
  "keywords": [
    "devtools",
    "react",
    "nextjs",
    "toolbar",
    "debug",
    "network",
    "console",
    "viewport",
    "mcp",
    "webmcp",
    "ui-sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/install.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "default": "./dist/install.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "rm -rf dist && pnpm build:css && tsup",
    "dev": "rm -rf dist && pnpm build:css && tsup --watch",
    "pretest": "pnpm build:css",
    "test": "vitest run",
    "pretypecheck": "pnpm build:css",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "react-grab": "^0.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "jsdom": "^31.0.1",
    "next": "16.4.6",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtifactyNight/react-devbelt.git",
    "directory": "packages/react-devbelt"
  },
  "bugs": {
    "url": "https://github.com/ArtifactyNight/react-devbelt/issues"
  },
  "homepage": "https://github.com/ArtifactyNight/react-devbelt#readme"
}
