{
  "name": "devbelt-plugin-tanstack-query",
  "version": "0.1.0",
  "description": "A react-devbelt Package plugin for TanStack Query v5: inspect queries and mutations from the dev toolbar.",
  "keywords": [
    "devbelt",
    "devbelt-plugin",
    "tanstack-query",
    "react-query",
    "devtools"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "pretest": "pnpm --filter react-devbelt build",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter react-devbelt build",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=19",
    "react-devbelt": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tanstack/react-query": "^5.108.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-devbelt": "workspace:*",
    "react-dom": "19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtifactyNight/react-devbelt.git",
    "directory": "packages/devbelt-plugin-tanstack-query"
  },
  "bugs": {
    "url": "https://github.com/ArtifactyNight/react-devbelt/issues"
  },
  "homepage": "https://github.com/ArtifactyNight/react-devbelt#readme"
}
